# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database (MySQL) — used by Prisma's `datasource db` block.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=villagedb
DB_USER=root
DB_PASSWORD=your_password

# ---------------------------------------------------------------------------
# Auth — POST /api/v1/auth/{inscription,connexion,refresh}, GET /api/v1/auth/moi
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ---------------------------------------------------------------------------
# SMTP — optional. Unset, the welcome email (POST /auth/inscription) is
# logged instead of sent (see src/services/email.service.ts) rather than
# failing account creation; account creation and auto-login work either way.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Moussidalheire <no-reply@moussidalheire.example>"

# ---------------------------------------------------------------------------
# CORS — the frontend's dev origin (Vite default port; see moussidalheire-main)
# ---------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
