# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database (MySQL) — used by Prisma's `datasource db` block.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=villagedb
DB_USER=root
DB_PASSWORD=your_password

# ---------------------------------------------------------------------------
# Auth — POST /api/v1/auth/{inscription,connexion,refresh}, GET /api/v1/auth/moi
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ---------------------------------------------------------------------------
# SMTP — optional. Unset, the welcome email (POST /auth/inscription) is
# logged instead of sent (see src/services/email.service.ts) rather than
# failing account creation; account creation and auto-login work either way.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Moussidalheire <no-reply@moussidalheire.example>"

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins. Vite serves the app
# on 5173 in dev (`npm run dev`) and on 4173 in preview (`npm run preview`),
# so both are listed here; whitespace around each entry is trimmed.
# In production this is normally a single origin — the site's own domain,
# since nginx serves the frontend and proxies /api/v1 on that same origin.
# ---------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"

# ---------------------------------------------------------------------------
# APP_URL — public URL of the frontend, used to build links inside emails
# (see src/services/email.service.ts). Must be ONE origin, never a list.
# Optional: when unset, it falls back to the first entry of CORS_ORIGIN.
# Set it explicitly in production, where CORS_ORIGIN may list several origins
# and the first one is not necessarily the address to send users to.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
